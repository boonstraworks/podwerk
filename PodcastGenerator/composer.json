{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "boonstraworks/podwerk",
    "description": "Open source podcast publishing without a database. Maintained continuation of Podcast Generator.",
    "version": "3.2.10",
    "type": "project",
    "keywords": [
        "podcast",
        "podcasting",
        "website generator",
        "podcast generator"
    ],
    "homepage": "https://github.com/boonstraworks/podwerk",
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "BoonstraWorks",
            "homepage": "https://boonstraworks.nl",
            "role": "Maintainer"
        },
        {
            "name": "Chris Charabaruk",
            "homepage": "https://chris.charabaruk.com",
            "role": "Developer"
        },
        {
            "name": "Emil Engler",
            "homepage": "http://www.emilengler.com",
            "role": "Developer"
        },
        {
            "name": "Alberto Betella",
            "homepage": "https://betella.net",
            "role": "Original developer"
        }
    ],
    "support": {
        "issues": "https://github.com/boonstraworks/podwerk/issues",
        "source": "https://github.com/boonstraworks/podwerk"
    },
    "require": {
        "php": ">=7.0",
        "ext-gettext": "*",
        "ext-simplexml": "*",
        "composer/installers": "~1.9.0",
        "james-heinrich/getid3": "~1.9.19"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "squizlabs/php_codesniffer": "^3.6"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
